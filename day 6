## INTERFACES  ## 

interface A
{
  int a = 20;  // by default all the variable is final and static , and if the variable is final we need to initialize a variable 
  String area = "Astana"; // since they static we can directly use this variables -->(in main)
  
  void show(); // every method in interface is public and abstact by default 
  void config();

}
interface X
{
  void run
  {
    System.out.println("Running ");
  }
}

class B implements A, X  // class actually can implement multiple intefaces 
{
  public void show() {

    }


    public void config() {

    }

    public void run()
    {

    }
}

class Main
{
  public static void main(String[] a)
  {
    A obj; // we can instantiate an object , that means A is a interface type 
    obj = new A(); // but every time you create an object it will give you an error 
    obj = new B(); // we can create an object of B

    System.out.println(A.area);


    
  }
}

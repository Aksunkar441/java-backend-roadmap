## THREADS PRIORITY ## 
we can not tell the compler to work in different way , but we can optimize the way it prior and allocate the time or resource
many things to text but i coded my self 
class A implements Runnable
{
    public void run()
    {
        for (int i = 0;i<5;i++)
        {
            System.out.println("HI");
            try {
                Thread.sleep(10);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
        
    }
}

class B implements Runnable
{
    public void run()
    {
        for (int i = 0;i<5;i++)
        {
            System.out.println("Hello");
            try {
                Thread.sleep(10);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }

        
    }
}

class Main
{
    public static void main(String a[])
    {
 
        Runnable obj1 =  () ->  
            {
                for (int i = 0;i<5;i++)
                {
                    System.out.println("HI");
                    try {Thread.sleep(10);} 
                    catch (InterruptedException e) { e.printStackTrace();} // mandatory try-catch 
                }
            };

        Runnable obj2 = () -> 
            {
                for (int i = 0;i<5;i++)
                {
                    System.out.println("Hello");
                    try {Thread.sleep(10);} 
                    catch (InterruptedException e) { e.printStackTrace();}
                }
            };


        
        Thread t1 = new Thread(obj1); // we create a multiple threads for the object that it can be started and use the Runnable interface
        Thread t2 = new Thread(obj2);

        t2.setPriority(10);

        t1.start();
        t2.start();
    }
}





